def cmd_models():
    print(f"\n {BO('Available Models')}\n")
    seen = set()
    for n, k, b, m, mt, _ in PROVIDERS_RAW:
        prefix = "Sol" if n.startswith("Sol") else "DS "
        if m not in seen:
            print(f"  {G('●') if prefix == 'Sol' else C('●')} {n}  {D(f'({m})')}")
            seen.add(m)
    print(f"\n {D(f'{len(PROVIDERS_RAW)} routes across {len(seen)} models')}\n")

def main():
    cwd = os.getcwd()
    sessions = load_sessions()
    active_name = sessions.get("active")
    session_list = sessions.get("sessions", {})

    if active_name and active_name in session_list:
        msgs = session_list[active_name]["msgs"]
    else:
        msgs = [{"role": "system", "content": f"{SYSTEM}\nCWD: {cwd}"}]

    last_model = None
    try: readline.read_history_file(HIST_FILE)
    except: pass

    cols = shutil.get_terminal_size().columns

    if len(sys.argv) > 1 and sys.argv[1] != "run":
        # Direct one-shot
        p = " ".join(sys.argv[1:])
        if p.startswith("/read "):
            c = file_content(p[6:])
            if c: print(c)
            return
        if p.startswith("/sh "):
            print(run_sh(p[4:])); return
        if p.startswith("/grep "):
            for f in search_grep(p[6:]): print(f)
            return

    if len(sys.argv) > 1:
        p = " ".join(sys.argv[1:]) if sys.argv[1] != "run" else " ".join(sys.argv[2:])
        msgs.append({"role": "user", "content": p})
        r, m = send(msgs)
        if r:
            f = stream_out(r); print()
            for s in save_blocks(f): print(f" {G('✓')} {os.path.basename(s)}")
        return

    os.system('clear')
    bl = budget_line()
    print(f" {C('◆')} {BO('ProCode')}  {G('GPT-5.6 Sol Pro')} {D('→ DS V4 Pro')}  {D('│')}  {bl}")
    print()

    while True:
        try: inp = input(f" {C('▸')} ").strip()
        except: print(); break
        if not inp: continue

        if inp in ("exit", "quit", "/q"): print(); break

        # Commands
        if inp == "/clear": os.system('clear'); print(f" {C('◆')} {BO('ProCode')}  {G('GPT-5.6 Sol Pro')} {D('→ DS V4 Pro')}  {D('│')}  {budget_line()}\n"); continue
        if inp == "/help": cmd_help(); continue
        if inp == "/budget":
            refresh_budget()
            bl = budget_line()
            print(f" {bl}")
            continue
        if inp == "/models": cmd_models(); continue
        if inp == "/undo": cmd_undo(msgs); continue
        if inp == "/export": cmd_export(msgs); continue
        if inp.startswith("/read "):
            c = file_content(inp[6:])
            if c is not None:
                print(f"\n{D('── ' + inp[6:] + ' ──')}")
                print(f"{c}")
            else: print(f" {R('✗')} Not found")
            continue
        if inp.startswith("/write "): cmd_write(inp[7:]); continue
        if inp.startswith("/edit "): cmd_edit(inp[6:]); continue
        if inp.startswith("/sh "): print(run_sh(inp[4:])); continue
        if inp.startswith("/grep "):
            for f in search_grep(inp[6:]): print(f" {D('·')} {f}")
            continue
        if inp.startswith("/glob "):
            import glob as gb
            for f in gb.glob(inp[6:], recursive=True)[:20]:
                if os.path.isfile(f): print(f" {D('·')} {f}")
            continue
        if inp.startswith("/save "):
            name = inp[6:].strip()
            if not name: name = f"session_{len(session_list)}"
            session_list[name] = {"msgs": msgs.copy(), "time": time.time()}
            sessions["sessions"] = session_list
            sessions["active"] = name
            save_sessions(sessions)
            print(f" {G('✓')} Saved as '{name}'")
            continue
        if inp.startswith("/load "):
            name = inp[6:].strip()
            if name in session_list:
                msgs = session_list[name]["msgs"]
                sessions["active"] = name
                save_sessions(sessions)
                print(f" {G('✓')} Loaded '{name}' ({len(msgs)} messages)")
            else: print(f" {R('✗')} Session '{name}' not found")
            continue
        if inp == "/sessions":
            if not session_list: print(f" {Y('-')} No saved sessions")
            else:
                for name, s in session_list.items():
                    cnt = len(s["msgs"]); print(f" {G('\u25cf')} {name}  {D(f'({cnt} msgs)')}")
            continue

        # Handle @file attachments
        attachment = None
        at_match = re.search(r'@(\S+)', inp)
        if at_match:
            q = at_match.group(1)
            files = fuzzy_files(q, limit=5)
            if files:
                attachment = files[0]
                fc = file_content(attachment)
                if fc:
                    inp = inp.replace(at_match.group(0), "")
                    inp = f"[File: {attachment}]\n```\n{fc}\n```\n{inp}"

        # Handle !commands
        if inp.startswith("!"):
            out = run_sh(inp[1:])
            inp = f"$ {inp[1:]}\n{out}"

        # Process inline commands
        inp_proc = re.sub(r'/read\s+(\S+)', lambda m: (
            f"\n```\n{open(os.path.expanduser(m.group(1))).read()}\n```\n"
            if os.path.exists(os.path.expanduser(m.group(1))) else ""
        ), inp)
        inp_proc = re.sub(r'/sh\s+(.*)', lambda m: f"\n$ {m.group(1)}\n{run_sh(m.group(1))}\n", inp_proc)

        msgs.append({"role": "user", "content": inp_proc})
        r, m = send(msgs)
        if not r: continue
        if m != last_model:
            c = G if m.startswith("Sol") else C
            print(f" {c(f'[{m}]')}")
            last_model = m
        f = stream_out(r); print()
        msgs.append({"role": "assistant", "content": f})
        saved = save_blocks(f)
        if saved:
            names = [os.path.basename(s) for s in saved]
            print(f" {D('─')} {BO(', '.join(names))}")

        # Auto-save session
        session_list["_latest"] = {"msgs": msgs.copy(), "time": time.time()}
        sessions["sessions"] = session_list
        save_sessions(sessions)

    try:
        readline.write_history_file(HIST_FILE)
        if len(msgs) > 1:
            session_list["_latest"] = {"msgs": msgs.copy(), "time": time.time()}
            sessions["sessions"] = session_list
            save_sessions(sessions)
    except: pass

if __name__ == "__main__":
    main()