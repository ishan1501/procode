    print(f"\n {B('Free Model Chain')}\n")
    tiers = [("1. DS V4 Pro", C, "deepseek-ai/deepseek-v4-pro", "NVIDIA", "Best coding"),
             ("2. Llama4 Mav", G, "meta/llama-4-maverick-17b-128e-instruct", "NVIDIA", "Fast, 3s"),
