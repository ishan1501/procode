def cmd_models():
    print(f"\n {B('Model Chain')}\n")
    seen = set()
    tier = 1
    for n, k, b, m, mt, _, to in PROVIDERS_RAW:
        tag = model_tag(n)
        api = "OR" if b == OR_BASE else "NV"
        cost = "free" if "free" in m else (r"$5+" if "sol" in m.lower() else "paid")
        prefix = f"T{tier}"
        print(f"  {model_color(n)('●')} {n:15s} {W(f'({m[:45]})')}  {D(f'{api} {to}s {cost}')}")
        if m not in seen:
            seen.add(m)
            tier += 1
    print(f"\n  {D(f'{len(PROVIDERS_RAW)} routes • {len(seen)} models • 6 tiers')}\n")

def main():
    cwd = os.getcwd()
    sessions = load_sessions()
    active_name = sessions.get("active")
    session_list = sessions.get("sessions", {})

    if isinstance(session_list, list):
        session_list = {}
        sessions["sessions"] = session_list

    if active_name and active_name in session_list:
        msgs = session_list[active_name]["msgs"]
    else:
        msgs = [{"role": "system", "content": f"{SYSTEM}\nCWD: {cwd}"}]

    last_model = None
    try: readline.read_history_file(HIST_FILE)
    except: pass

    # One-shot mode
    if len(sys.argv) > 1:
        p = " ".join(sys.argv[1:])
        if p.startswith("/sh "):
            print(run_sh(p[4:]))
        elif p.startswith("/read "):
            cmd_read(p[6:])
        elif p.startswith("/grep "):
            for f in search_grep(p[6:]): print(f)
        elif p.startswith("/glob "):
            for f in gb.glob(p[6:], recursive=True)[:20]:
                if os.path.isfile(f): print(f)
        else:
            msgs.append({"role": "user", "content": p})
            r, m = send(msgs)
            if r:
                f = stream_out(r); print()
                for s in save_blocks(f): print(f" {G('✓')} {os.path.basename(s)}")
        return

    os.system('clear')
    bl = budget_line()
    print(header_line(bl))
    print()

    while True:
        try: inp = input(f" {C('▸')} ").strip()
        except: print(); break
        if not inp: continue

        if inp in ("exit", "quit", "/q"): print(); break
        if inp == "/clear":
            os.system('clear')
            bl = budget_line()
            print(header_line(bl))
            print()
            continue
        if inp == "/help": cmd_help(); continue
        if inp == "/budget":
            refresh_budget()
            print(f" {budget_line()}  {W(f'${_usage:.4f} used')}")
            continue
        if inp == "/models": cmd_models(); continue
        if inp == "/undo": cmd_undo(msgs); continue
        if inp == "/export": cmd_export(msgs); continue
        if inp == "/status": cmd_status(); continue
        if inp.startswith("/read "): cmd_read(inp[6:]); continue
        if inp.startswith("/write "): cmd_write(inp[7:]); continue
        if inp.startswith("/edit "): cmd_edit(inp[6:]); continue
        if inp.startswith("/diff "): cmd_diff(inp[6:]); continue
        if inp.startswith("/sh "):
            print(run_sh(inp[4:])); continue
        if inp.startswith("/grep "):
            for f in search_grep(inp[6:]): print(f" {D('·')} {f}")
            continue
        if inp.startswith("/glob "):
            for f in gb.glob(inp[6:], recursive=True)[:20]:
                if os.path.isfile(f): print(f" {D('·')} {f}")
            continue
        if inp.startswith("/save "):
            name = inp[6:].strip()
            if not name: name = f"session_{len(session_list)+1}"
            session_list[name] = {"msgs": msgs.copy(), "time": time.time()}
            sessions["sessions"] = session_list
            sessions["active"] = name
            save_sessions(sessions)
            print(f" {G('✓')} Saved '{name}'  {W(f'({len(msgs)} msgs)')}")
            continue
        if inp.startswith("/load "):
            name = inp[6:].strip()
            if name in session_list:
                msgs = session_list[name]["msgs"]
                sessions["active"] = name
                save_sessions(sessions)
                print(f" {G('✓')} Loaded '{name}'  {W(f'({len(msgs)} msgs)')}")
            else: print(f" {R('✗')} Session '{name}' not found")
            continue
        if inp == "/sessions":
            if not session_list: print(f" {Y('-')} No saved sessions")
            else:
                for name, s in session_list.items():
                    age = ""
                    if "time" in s:
                        diff_m = int((time.time() - s["time"]) / 60)
                        if diff_m < 1: age = "just now"
                        elif diff_m < 60: age = f"{diff_m}m ago"
                        else: age = f"{diff_m//60}h ago"
                    mcnt = len(s["msgs"]); print(f"  {G('\u25cf')} {name:20s} {D(f'{mcnt} msgs')} {W(age)}")
            continue

        # Handle @file attachments
        at_match = re.search(r'@(\S+)', inp)
        if at_match:
            q = at_match.group(1)
            files = fuzzy_files(q, limit=5)
            if files: attachment = files[0]
            else: attachment = None
            if attachment:
                fc = file_content(attachment)
                if fc:
                    ext = os.path.splitext(attachment)[1].lstrip(".")
                    inp = inp.replace(at_match.group(0), "")
                    inp = f"See attached file `{attachment}`:\n```{ext}\n{fc}\n```\n{inp}"
                    print(f" {D('@')} {attachment}")

        # Handle !commands
        if inp.startswith("!"):
            out = run_sh(inp[1:])
            inp = f"$ {inp[1:]}\n{out}"

        # Process inline /read and /sh
        inp_proc = re.sub(r'/read\s+(\S+)', lambda m: (
            f"\n```\n{open(os.path.expanduser(m.group(1))).read()}\n```\n"
            if os.path.exists(os.path.expanduser(m.group(1))) else m.group(0)
        ), inp)
        inp_proc = re.sub(r'/sh\s+(.*)', lambda m: f"\n$ {m.group(1)}\n{run_sh(m.group(1))}\n", inp_proc)

        msgs.append({"role": "user", "content": inp_proc})
        r, m = send(msgs)
        if not r:
            print(f" {R('✗')} No model responded")
            msgs.pop()
            continue

        if m != last_model:
            print(f" {model_color(m)(f'[{m}]')}")
            last_model = m
        f = stream_out(r); print()
        msgs.append({"role": "assistant", "content": f})

        saved = save_blocks(f)
        if saved:
            names = [os.path.basename(s) for s in saved]
            print(f" {D('─')} {G(', '.join(names))}")

        # Auto-save latest session
        session_list["_latest"] = {"msgs": msgs.copy(), "time": time.time()}
        sessions["sessions"] = session_list
        save_sessions(sessions)

    try:
        readline.write_history_file(HIST_FILE)
        if len(msgs) > 1:
            session_list["_latest"] = {"msgs": msgs.copy(), "time": time.time()}
            sessions["sessions"] = session_list
            save_sessions(sessions)
    except: pass

if __name__ == "__main__":
    main()