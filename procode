#!/usr/bin/env python3
import sys, os, json, subprocess, re, readline, urllib.request, time, textwrap, shutil, glob as gb
from datetime import datetime
from openai import OpenAI

DATA_DIR = os.path.expanduser("~/.procode")
CONFIG_PATH = os.path.join(DATA_DIR, "config.json")
SESSION_FILE = os.path.join(DATA_DIR, "session.json")
HIST_FILE = os.path.join(DATA_DIR, "history")
os.makedirs(DATA_DIR, exist_ok=True)

def _load_config():
    c = {}
    try:
        with open(CONFIG_PATH) as f: c = json.load(f)
    except: pass
    for k in ("PROCODE_OR_KEY","PROCODE_NV_KEY","PROCODE_OR_BASE","PROCODE_NV_BASE"):
        v = os.environ.get(k)
        if v: c[k.lower().replace("procode_","")] = v
    return c

_cfg = _load_config()
OR_KEY = _cfg.get("or_key", "")
NV_KEY = _cfg.get("nv_key", "")
OR_BASE = _cfg.get("or_base", "https://openrouter.ai/api/v1")
NV_BASE = _cfg.get("nv_base", "https://integrate.api.nvidia.com/v1")

# Fastest first for quick responses
PROVIDERS_RAW = [
    ("Llama4 Mav",   NV_KEY, NV_BASE, "meta/llama-4-maverick-17b-128e-instruct", 8192, {}, 30),
    ("DS V4 Pro",    NV_KEY, NV_BASE, "deepseek-ai/deepseek-v4-pro", 16384, {}, 35),
    ("Nemotron S49", NV_KEY, NV_BASE, "nvidia/llama-3.3-nemotron-super-49b-v1", 8192, {}, 30),
    ("Nem Reason",   OR_KEY, OR_BASE, "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free", 8192, {}, 25),
]

CLIENTS = {}
for n, k, b, _, _, _, _ in PROVIDERS_RAW:
    try: CLIENTS[n] = OpenAI(api_key=k, base_url=b) if k else None
    except: pass

G = lambda t: f"\033[38;5;46m{t}\033[0m"
Y = lambda t: f"\033[38;5;227m{t}\033[0m"
C = lambda t: f"\033[38;5;87m{t}\033[0m"
B = lambda t: f"\033[1m{t}\033[0m"
D = lambda t: f"\033[2m{t}\033[0m"
R = lambda t: f"\033[38;5;196m{t}\033[0m"
W = lambda t: f"\033[38;5;250m{t}\033[0m"
BL = lambda t: f"\033[38;5;33m{t}\033[0m"

SYSTEM = "You are ProCode, a helpful coding assistant. Talk conversationally. Only write code when asked. When you do write code, output files inside ```code blocks with filename on first line as comment. Use /sh to run commands when helpful."

_usage = 0.216
_last_budget_check = 0
_session_tokens = {"prompt": 0, "completion": 0, "total": 0}
_last_response_time = 0
_last_model_name = ""
SESSION_TOKEN_LIMIT = 100000

def refresh_budget():
    global _usage, _last_budget_check
    if time.time() - _last_budget_check < 60: return
    try:
        req = urllib.request.Request(f"{OR_BASE}/auth/key", headers={"Authorization":f"Bearer {OR_KEY}"})
        d = json.loads(urllib.request.urlopen(req, timeout=5).read())
        _usage = d.get("data",{}).get("usage", _usage)
        _last_budget_check = time.time()
    except: pass

def budget_line():
    refresh_budget()
    p = max(0, min(1, 1 - _usage / 1.0))
    w = 14
    f = int(p * w)
    bar = "━" * f + "─" * (w - f)
    c = G if p > 0.6 else Y if p > 0.3 else R
    return f"{c(bar)} {c(f'{p*100:.0f}%')}"

def token_pct():
    t = _session_tokens["total"]
    if t == 0: return ""
    pct = min(100, t / SESSION_TOKEN_LIMIT * 100)
    bar_w = 8
    f = max(1, int(pct / 100 * bar_w))
    bar = "━" * f + "─" * (bar_w - f)
    c = G if pct < 50 else Y if pct < 80 else R
    return f"{c(bar)} {c(f'{pct:.0f}%')} {W(f'{t//1000}Ktok')}"

def header():
    bl = budget_line()
    tk = token_pct()
    parts = [f" {C('\u25c6')} {B('ProCode')}", f"{G('FREE')}", f"{D('|')}  {bl}", f"{D('|')}  {tk}"]
    return " ".join(parts)[:shutil.get_terminal_size().columns]

def model_color(name):
    if "Mav" in name: return G
    if "Pro" in name: return C
    if "S49" in name: return BL
    return W

def model_icon(name):
    if "Mav" in name: return "\u25b6"
    if "Pro" in name: return "\u25c6"
    if "S49" in name: return "\u25a0"
    return "\u25cb"

def estimate_tokens(text):
    return max(1, len(text) // 4)

def call_api_stream(name, msgs, max_tok=4096):
    c = CLIENTS.get(name)
    if not c: return None, 0, 0
    p = next(x for x in PROVIDERS_RAW if x[0] == name)
    kw = {"model": p[3], "messages": msgs, "max_tokens": min(max_tok, p[4]), "stream": True,
          "extra_headers": {"HTTP-Referer":"https://procode.ai","X-Title":"ProCode"}}
    if p[5]: kw["extra_body"] = p[5]
    try:
        start = time.time()
        r = c.chat.completions.create(**kw, timeout=p[6])
        it = iter(r)
        first = None
        for chunk in it:
            if chunk.choices and chunk.choices[0].delta and chunk.choices[0].delta.content:
                first = chunk; break
            if chunk.usage: break
        if first is None: return None, 0, 0
        icon = model_icon(name)
        sys.stdout.write(f" {model_color(name)(f'{icon} [{name}]')} ")
        t = first.choices[0].delta.content
        sys.stdout.write(t); sys.stdout.flush()
        content = t
        usage = first.usage if first.usage else None
        for chunk in it:
            if chunk.choices and chunk.choices[0].delta and chunk.choices[0].delta.content:
                t = chunk.choices[0].delta.content
                content += t
                sys.stdout.write(t); sys.stdout.flush()
            if chunk.usage:
                usage = chunk.usage
        elapsed = time.time() - start
        if usage:
            pt = usage.prompt_tokens if usage.prompt_tokens else 0
            ct = usage.completion_tokens if usage.completion_tokens else 0
        else:
            pt = estimate_tokens(msgs[-1]["content"]) if msgs else 0
            ct = estimate_tokens(content)
        sys.stdout.write(f" {D(f'{elapsed:.1f}s')}\n")
        sys.stdout.flush()
        return content, pt, ct
    except: return None, 0, 0

def send(msgs):
    global _last_response_time, _last_model_name
    for p in PROVIDERS_RAW:
        start = time.time()
        content, pt, ct = call_api_stream(p[0], msgs)
        if content:
            _last_response_time = time.time() - start
            _last_model_name = p[0]
            _session_tokens["prompt"] += pt
            _session_tokens["completion"] += ct
            _session_tokens["total"] += pt + ct
            return content, p[0]
    return None, None

def run_sh(cmd):
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=60)
        return (r.stdout + r.stderr)[:10000]
    except: return ""

def fuzzy_files(q, limit=10):
    ql = q.lower()
    res = []
    for root, dirs, files in os.walk("."):
        dn = os.path.basename(root)
        if dn.startswith(".") or dn in ("__pycache__","node_modules"): continue
        for f in files:
            fp = os.path.join(root, f)
            if ql in fp.lower() or ql in f.lower():
                try: res.append((fp, os.path.getsize(fp)))
                except: pass
    res.sort(key=lambda x: x[1])
    return [r[0][2:] if r[0].startswith("./") else r[0] for r in res[:limit]]

def file_content(path):
    try: return open(os.path.expanduser(path)).read()
    except: return None

def search_grep(pattern, path="."):
    try:
        r = subprocess.run(f"rg -l '{pattern}' {path} 2>/dev/null || grep -rl '{pattern}' {path} 2>/dev/null", shell=True, capture_output=True, text=True, timeout=15)
        return [f for f in r.stdout.strip().split("\n") if f][:30]
    except: return []

def save_blocks(text):
    saved = []
    for lang, code in re.findall(r'```(\w*)\n(.*?)```', text, re.DOTALL):
        code = code.strip()
        if not code: continue
        fn = None
        for l in code.split("\n")[:3]:
            m = re.match(r'^(?:#|//|--)\s*(.+)', l)
            if m: fn = m.group(1).strip(); break
        if not fn:
            m = re.search(r'filename[=:]\s*"?([^"\s]+)"?', text)
            fn = m.group(1) if m else f"out_{datetime.now().strftime('%H%M%S')}.{lang or 'txt'}"
        p = os.path.expanduser(fn)
        os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
        try:
            with open(p,"w") as f: f.write(code)
            saved.append(p)
        except: pass
    if not saved:
        lines = text.strip().split("\n")
        if lines:
            m = re.match(r'^(?:#|//|--)\s*(\S+\.\w+)', lines[0])
            if m:
                p = os.path.expanduser(m.group(1))
                try:
                    with open(p,"w") as f: f.write("\n".join(lines[1:]))
                    saved.append(p)
                except: pass
    return saved

def load_sessions():
    try:
        with open(SESSION_FILE) as f: return json.load(f)
    except: return {"sessions": {}, "active": None}

def save_sessions(data):
    try:
        with open(SESSION_FILE, "w") as f: json.dump(data, f)
    except: pass

def cmd_read(args):
    c = file_content(args)
    if c is not None:
        _, ext = os.path.splitext(args)
        lang = ext.lstrip(".") if ext else ""
        lines = c.count("\n") + 1
        print(f"\n{D('\u2500' * 4)} {W(args)} {D(f'{lines}L {len(c)}B')} {D('\u2500' * max(2, shutil.get_terminal_size().columns - len(args) - 20))}")
        if lang in ("py","js","ts","go","rs","java","c","cpp","h","css","html","xml","json","yaml","yml","toml","sh","bash","md","rb","php","swift","kt","sql"):
            print(f"```{lang}\n{c}\n```")
        else: print(c)
    else: print(f" {R('\u2717')} File not found: {args}")

def cmd_write(args):
    parts = args.split(None, 1)
    if not parts: print(f" {R('\u2717')} /write <file> <content>"); return
    fpath = os.path.expanduser(parts[0])
    content = parts[1] if len(parts) > 1 else ""
    os.makedirs(os.path.dirname(fpath) or ".", exist_ok=True)
    try:
        with open(fpath, "w") as f: f.write(content)
        print(f" {G('\u2713')} {W(os.path.basename(fpath))}  {D(f'{len(content)}B')}")
    except Exception as e: print(f" {R('\u2717')} {e}")

def cmd_edit(args):
    parts = args.split(None, 1)
    if not parts: print(f" {R('\u2717')} /edit <file> <content>"); return
    fpath = os.path.expanduser(parts[0])
    if not os.path.exists(fpath): cmd_write(args); return
    old = open(fpath).read()
    new = parts[1] if len(parts) > 1 else ""
    try:
        with open(fpath, "w") as f: f.write(new)
        lo, ln = old.count("\n")+1, new.count("\n")+1
        print(f" {G('\u2713')} {W(os.path.basename(fpath))}  {D(f'{lo}\u2192{ln}L')}")
    except Exception as e: print(f" {R('\u2717')} {e}")

def cmd_diff(args):
    if not args: print(f" {R('\u2717')} /diff <file>"); return
    fpath = os.path.expanduser(args)
    if not os.path.exists(fpath): print(f" {R('\u2717')} Not found"); return
    r = subprocess.run(f"git diff --stat HEAD -- '{fpath}' 2>/dev/null || echo 'NOGIT'", shell=True, capture_output=True, text=True, timeout=5)
    if r.returncode == 0 and r.stdout.strip() and "NOGIT" not in r.stdout:
        subprocess.run(f"git diff HEAD -- '{fpath}' | head -80", shell=True)
    else: print(f" {Y('\u00b7')} No diff available")

def cmd_status():
    r = subprocess.run("git status --short 2>/dev/null || echo 'NOGIT'", shell=True, capture_output=True, text=True, timeout=5)
    out = r.stdout.strip()
    if "NOGIT" in out: print(f" {Y('\u00b7')} Not a git repo")
    elif out: print(f" {C('\u2387')} {out}")
    else: print(f" {G('\u2713')} Clean tree")

def cmd_undo(msgs):
    if len(msgs) < 2: print(f" {Y('-')} Nothing to undo"); return
    msgs.pop(); msgs.pop()
    print(f" {G('\u2713')} Undone")

def cmd_export(msgs):
    path = os.path.join(DATA_DIR, f"session_{datetime.now().strftime('%Y%m%d_%H%M%S')}.md")
    try:
        with open(path, "w") as f:
            f.write("# ProCode Session\n\n")
            for m in msgs:
                if m["role"] == "system": continue
                label = "You" if m["role"] == "user" else "ProCode"
                f.write(f"**{label}:**\n{m['content']}\n\n")
        print(f" {G('\u2713')} Exported {W(f'{len(msgs)} msgs')} {D(f'\u2192 {os.path.basename(path)}')}")
    except Exception as e: print(f" {R('\u2717')} {e}")

def cmd_stats():
    t = _session_tokens
    tp, tc, tt = t["prompt"], t["completion"], t["total"]
    pct = min(100, tt / SESSION_TOKEN_LIMIT * 100) if tt else 0
    print(f" {B('Session Stats')}")
    print(f"  {W('Tokens:')}   {D('prompt')} {tp:>6}  {D('completion')} {tc:>6}  {D('total')} {tt:>6}")
    print(f"  {W('Used:')}     {pct:.1f}% of {SESSION_TOKEN_LIMIT//1000}K limit")
    print(f"  {W('Budget:')}   ${_usage:.4f}")
    if _last_response_time:
        rt = _last_response_time
        c = G if rt < 5 else Y if rt < 15 else R
        print(f"  {W('Last:')}    {_last_model_name}  {c(f'{rt:.1f}s')}")

def cmd_help():
    print(f" {C('ProCode')} {W('- Free AI coding agent')}  {D('v3.1')}")
    print()
    print(f" {B('Commands')}")
    for cmd, desc in [
        ("/help","Show this help"),("/clear","Clear screen"),
        ("/read <file>","Read file with syntax highlight"),
        ("/write <file> <c>","Write content to file"),
        ("/edit <file> <c>","Edit existing file"),
        ("/diff <file>","Show git diff"),("/status","Git working tree status"),
        ("/sh <cmd>","Run shell command"),("/grep <q>","Search file contents"),
        ("/glob <p>","Find files by pattern"),("/undo","Undo last AI exchange"),
        ("/export","Export session to markdown"),
        ("/stats","Session tokens & budget"),
        ("/models","List model chain"),("/sessions","List saved sessions"),
        ("/save <name>","Save session"),("/load <name>","Load session"),
    ]:
        print(f"  {C(cmd):24s} {W(desc)}")
    print()
    print(f" {B('Features')}    {G('@<pattern>')} {W('attach file')}   {G('!<cmd>')} {W('inline shell')}   {C('exit')}/{C('quit')}")
    print()
    print(f" {B('Chain')}  {G('\u25b6')} Llama4 Mav  {W('\u2192')}  {C('\u25c6')} DS V4 Pro  {W('\u2192')}  {BL('\u25a0')} Nem S49  {W('\u2192')}  {W('\u25cb')} Nem Reason")
    print(f"  {D('0.8s TTFB \u2192 5s TTFB \u2192 15s \u2192 42s (last resort)')}")

def cmd_models():
    print(f"\n {B('Model Chain')}  {D('(fastest first)')}\n")
    tiers = [("Llama4 Mav", G, "meta/llama-4-maverick-17b-128e-instruct", "NVIDIA", "0.8s TTFB"),
             ("DS V4 Pro", C, "deepseek-ai/deepseek-v4-pro", "NVIDIA", "5s TTFB, best code"),
             ("Nemotron S49", BL, "nvidia/llama-3.3-nemotron-super-49b-v1", "NVIDIA", "15s fallback"),
             ("Nem Reason", W, "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free", "OpenRouter", "42s, last resort")]
    for label, color, model, api, note in tiers:
        print(f"  {color('\u25c9')} {label:18s} {W(model[:50])}")
        print(f"  {' ' * 22} {D(f'{api} \u00b7 {note}')}")
        print()
    t = _session_tokens
    pct = min(100, t["total"] / SESSION_TOKEN_LIMIT * 100) if t["total"] else 0
    print(f"  {D(f'5 routes \u00b7 4 models \u00b7 0 cost')}")
    ttot = t["total"]
    print(f"  {D(f'Tokens: {ttot} total ({pct:.0f}% of {SESSION_TOKEN_LIMIT//1000}K limit)')}")
    print()

def main():
    cwd = os.getcwd()
    sessions = load_sessions()
    active_name = sessions.get("active")
    session_list = sessions.get("sessions", {})

    if isinstance(session_list, list):
        session_list = {}
        sessions["sessions"] = session_list

    if active_name and active_name in session_list:
        msgs = session_list[active_name]["msgs"]
    else:
        msgs = [{"role": "system", "content": f"{SYSTEM}\nCWD: {cwd}"}]

    global _session_tokens
    if active_name and active_name in session_list:
        st = session_list[active_name].get("tokens", {})
        _session_tokens = {"prompt": st.get("prompt",0), "completion": st.get("completion",0), "total": st.get("total",0)}
    try: readline.read_history_file(HIST_FILE)
    except: pass

    if len(sys.argv) > 1:
        p = " ".join(sys.argv[1:])
        if p.startswith("/sh "): print(run_sh(p[4:])); return
        if p.startswith("/read "): cmd_read(p[6:]); return
        if p.startswith("/grep "):
            for f in search_grep(p[6:]): print(f)
            return
        if p.startswith("/glob "):
            for f in gb.glob(p[6:], recursive=True)[:20]:
                if os.path.isfile(f): print(f)
            return
        msgs.append({"role": "user", "content": p})
        content, model = send(msgs)
        if content:
            print()
            saved = save_blocks(content)
            for s in saved: print(f" {G('\u2713')} {os.path.basename(s)}")
            msgs.append({"role": "assistant", "content": content})
        return

    os.system('clear')
    print(header())
    print()

    while True:
        try: inp = input(f" {C('\u25b8')} ").strip()
        except: print(); break
        if not inp: continue

        if inp in ("exit", "quit", "/q"): print(); break
        if inp == "/clear": os.system('clear'); print(header()); print(); continue
        if inp == "/help": cmd_help(); continue
        if inp == "/stats": cmd_stats(); continue
        if inp == "/models": cmd_models(); continue
        if inp == "/undo": cmd_undo(msgs); continue
        if inp == "/export": cmd_export(msgs); continue
        if inp == "/status": cmd_status(); continue
        if inp.startswith("/read "): cmd_read(inp[6:]); continue
        if inp.startswith("/write "): cmd_write(inp[7:]); continue
        if inp.startswith("/edit "): cmd_edit(inp[6:]); continue
        if inp.startswith("/diff "): cmd_diff(inp[6:]); continue
        if inp.startswith("/sh "): print(run_sh(inp[4:])); continue
        if inp.startswith("/grep "):
            for f in search_grep(inp[6:]): print(f" {D('\u00b7')} {f}")
            continue
        if inp.startswith("/glob "):
            for f in gb.glob(inp[6:], recursive=True)[:20]:
                if os.path.isfile(f): print(f" {D('\u00b7')} {f}")
            continue
        if inp.startswith("/save "):
            name = inp[6:].strip()
            if not name: name = f"session_{len(session_list)+1}"
            data = {"msgs": msgs.copy(), "time": time.time(), "tokens": _session_tokens.copy()}
            session_list[name] = data
            sessions["sessions"] = session_list; sessions["active"] = name
            save_sessions(sessions)
            tt = _session_tokens["total"]
            print(f" {G('\u2713')} Saved '{name}'  {W(f'{len(msgs)} msgs, {tt}tok')}")
            continue
        if inp.startswith("/load "):
            name = inp[6:].strip()
            if name in session_list:
                msgs = session_list[name]["msgs"]; sessions["active"] = name
                st = session_list[name].get("tokens", {})
                _session_tokens = {"prompt": st.get("prompt",0), "completion": st.get("completion",0), "total": st.get("total",0)}
                save_sessions(sessions)
                print(f" {G('\u2713')} Loaded '{name}'  {W(f'{len(msgs)} msgs')}")
            else: print(f" {R('\u2717')} Session '{name}' not found")
            continue
        if inp == "/sessions":
            if not session_list: print(f" {Y('-')} No saved sessions")
            else:
                for name, s in session_list.items():
                    dm = int((time.time()-s.get("time",0))/60) if "time" in s else -1
                    age = "just now" if dm < 1 else f"{dm}m ago" if dm < 60 else f"{dm//60}h ago" if dm >= 0 else ""
                    tok = s.get("tokens",{}).get("total",0)
                    scnt = len(s["msgs"])
                    print(f"  {G('\u25c9')} {name:20s} {D(f'{scnt} msgs')} {W(f'{tok}tok')}  {D(age)}")
            continue

        at_match = re.search(r'@(\S+)', inp)
        if at_match:
            files = fuzzy_files(at_match.group(1), limit=5)
            if files:
                fc = file_content(files[0])
                if fc:
                    inp = inp.replace(at_match.group(0), "") + f"\n```\n{fc}\n```"
                    print(f" {D('@')} {files[0]}")

        if inp.startswith("!"):
            out = run_sh(inp[1:])
            inp = f"$ {inp[1:]}\n{out}"

        inp_proc = re.sub(r'/read\s+(\S+)', lambda m: (
            f"\n```\n{open(os.path.expanduser(m.group(1))).read()}\n```\n"
            if os.path.exists(os.path.expanduser(m.group(1))) else m.group(0)
        ), inp)
        inp_proc = re.sub(r'/sh\s+(.*)', lambda m: f"\n$ {m.group(1)}\n{run_sh(m.group(1))}\n", inp_proc)

        msgs.append({"role": "user", "content": inp_proc})

        content, model = send(msgs)

        if not content:
            print(f" {R('\u2717')} No model available")
            msgs.pop()
            continue

        msgs.append({"role": "assistant", "content": content})

        saved = save_blocks(content)
        if saved:
            names = [os.path.basename(s) for s in saved]
            print(f" {D('\u2500')} {G(', '.join(names))}")

        session_list["_latest"] = {"msgs": msgs.copy(), "time": time.time(), "tokens": _session_tokens.copy()}
        sessions["sessions"] = session_list
        save_sessions(sessions)

    try:
        readline.write_history_file(HIST_FILE)
        if len(msgs) > 1:
            session_list["_latest"] = {"msgs": msgs.copy(), "time": time.time(), "tokens": _session_tokens.copy()}
            sessions["sessions"] = session_list
            save_sessions(sessions)
    except: pass

if __name__ == "__main__":
    main()