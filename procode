SYSTEM = "You are ProCode. Write working code with no comments. Always output files inside ```code blocks with filename on first line as comment (# filename.py). Use /sh to run shell commands when needed."

_usage = 0.216
_last_budget_check = 0

def refresh_budget():
    global _usage, _last_budget_check
    if time.time() - _last_budget_check < 60: return
    try:
        req = urllib.request.Request(f"{OR_BASE}/auth/key", headers={"Authorization":f"Bearer {OR_KEY}"})
        d = json.loads(urllib.request.urlopen(req, timeout=5).read())
        _usage = d.get("data",{}).get("usage", _usage)
        _last_budget_check = time.time()
    except: pass

def budget_line():
    refresh_budget()
    limit = 1.0
    p = max(0, min(1, 1 - _usage / limit))
    w = 14
    f = int(p * w)
    bar = "━" * f + "─" * (w - f)
    c = G if p > 0.6 else Y if p > 0.3 else R
    spent = f"${_usage:.3f}"
    return f"Budget {c(bar)} {c(f'{p*100:.0f}%')} {W(spent)}"

def call_api(name, msgs, max_tok=4096):
    c = CLIENTS.get(name)
    if not c: return None
    p = next(x for x in PROVIDERS_RAW if x[0] == name)
    kw = {"model": p[3], "messages": msgs, "max_tokens": min(max_tok, p[4]), "stream": True,
          "extra_headers": {"HTTP-Referer":"https://procode.ai","X-Title":"ProCode"}}
    if p[5]: kw["extra_body"] = p[5]
    try: return c.chat.completions.create(**kw, timeout=p[6])
    except: return None

def send(msgs):
    for p in PROVIDERS_RAW:
        r = call_api(p[0], msgs)
        if r: return r, p[0]
    return None, None

def stream_out(resp):
    t = ""
    for c in resp:
        if c.choices and c.choices[0].delta and c.choices[0].delta.content:
            s = c.choices[0].delta.content; print(s, end="", flush=True); t += s
    return t

def run_sh(cmd):
    try: r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=60); return (r.stdout + r.stderr)[:10000]
    except: return f"Command timed out or failed: {cmd[:80]}"

def fuzzy_files(q, limit=10):
    ql = q.lower()
    res = []
    for root, dirs, files in os.walk("."):
        dn = os.path.basename(root)
        if dn.startswith(".") or dn == "__pycache__" or dn == "node_modules": continue
        for f in files:
            fp = os.path.join(root, f)
            if ql in fp.lower() or ql in f.lower():
                try: res.append((fp, os.path.getsize(fp)))
                except: pass
    res.sort(key=lambda x: x[1])
    return [r[0][2:] if r[0].startswith("./") else r[0] for r in res[:limit]]

def file_content(path):
    try: return open(os.path.expanduser(path)).read()
    except: return None

def search_grep(pattern, path="."):
    try:
        r = subprocess.run(f"rg -l '{pattern}' {path} 2>/dev/null || grep -rl '{pattern}' {path} 2>/dev/null", shell=True, capture_output=True, text=True, timeout=15)
        return [f for f in r.stdout.strip().split("\n") if f][:30]
    except: return []

def save_blocks(text, cwd="."):
    saved = []
    for lang, code in re.findall(r'```(\w*)\n(.*?)```', text, re.DOTALL):
        code = code.strip()
        if not code: continue
        fn = None
        for l in code.split("\n")[:3]:
            m = re.match(r'^(?:#|//|--)\s*(.+)', l)
            if m: fn = m.group(1).strip(); break
        if not fn:
            m = re.search(r'filename[=:]\s*"?([^"\s]+)"?', text)
            fn = m.group(1) if m else f"out_{datetime.now().strftime('%H%M%S')}.{lang or 'txt'}"
        p = os.path.expanduser(fn)
        os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
        try:
            with open(p,"w") as f: f.write(code)
            saved.append(p)
        except: pass
    if not saved:
        lines = text.strip().split("\n")
        if lines:
            m = re.match(r'^(?:#|//|--)\s*(\S+\.\w+)', lines[0])
            if m:
                p = os.path.expanduser(m.group(1))
                try:
                    with open(p,"w") as f: f.write("\n".join(lines[1:]))
                    saved.append(p)
                except: pass
    return saved

def load_sessions():
    try:
        with open(SESSION_FILE) as f: return json.load(f)
    except: return {"sessions": {}, "active": None}

def save_sessions(data):
    try:
        with open(SESSION_FILE, "w") as f: json.dump(data, f)
    except: pass

def model_tag(name):
    if name.startswith("Sol"): return "Sol"
    if name.startswith("DS"): return "DS"
    if "Llama" in name: return "L4"
    if "Nem" in name: return "Nem"
    return "?"

def model_color(name):
    if name.startswith("Sol"): return G
    if "Pro" in name: return C
    if "Flash" in name: return BL
    return W

def header_line(bl=""):
    cols = shutil.get_terminal_size().columns
    line = f" {C('◆')} {B('ProCode')}  {G('Sol Pro')}{D('→DS VP→DS VF→L4→Nem')}  {D('│')}  {bl}"
    return line[:cols]

def cmd_read(args):
    c = file_content(args)
    if c is not None:
        fn = os.path.basename(args)
        _, ext = os.path.splitext(fn)
        lang = ext.lstrip(".") if ext else ""
        print(f"\n{D(f'── {args} ')}{D('─' * max(2, shutil.get_terminal_size().columns - len(args) - 8))}")
        if lang in ("py","js","ts","go","rs","java","c","cpp","h","hpp","css","html","xml","json","yaml","yml","toml","sh","bash","zsh","sql","md","rb","php","swift","kt"):
            print(f"```{lang}\n{c}\n```")
        else:
            print(c)
    else:
        print(f" {R('✗')} File not found: {args}")

def cmd_write(args):
    parts = args.split(None, 1)
    if not parts:
        print(f" {R('✗')} Usage: /write <file> <content>"); return
    fpath = os.path.expanduser(parts[0])
    content = parts[1] if len(parts) > 1 else ""
    os.makedirs(os.path.dirname(fpath) or ".", exist_ok=True)
    try:
        with open(fpath, "w") as f: f.write(content)
        sz = len(content)
        print(f" {G('✓')} Wrote {fpath}  {W(f'({sz}B)')}")
    except Exception as e:
        print(f" {R('✗')} {e}")

def cmd_edit(args):
    parts = args.split(None, 1)
    if not parts:
        print(f" {R('✗')} Usage: /edit <file> <new content>"); return
    fpath = os.path.expanduser(parts[0])
    if not os.path.exists(fpath):
        cmd_write(args); return
    old = open(fpath).read()
    new = parts[1] if len(parts) > 1 else ""
    try:
        with open(fpath, "w") as f: f.write(new)
        lines_o, lines_n = old.count("\n"), new.count("\n")
        print(f" {G('✓')} Updated {fpath}  {W(f'{lines_o}→{lines_n} lines')}")
    except Exception as e:
        print(f" {R('✗')} {e}")

def cmd_diff(args):
    if not args:
        print(f" {R('✗')} Usage: /diff <file>"); return
    fpath = os.path.expanduser(args)
    if not os.path.exists(fpath):
        print(f" {R('✗')} Not found: {fpath}"); return
    try:
        r = subprocess.run(f"git diff --stat HEAD -- '{fpath}' 2>/dev/null || echo 'NOT A GIT REPO'", shell=True, capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            subprocess.run(f"git diff HEAD -- '{fpath}' | head -80", shell=True)
        else:
            print(f" {Y('·')} No git diff available for {fpath}")
    except: pass

def cmd_status():
    try:
        r = subprocess.run("git status --short 2>/dev/null || echo 'NOT A GIT REPO'", shell=True, capture_output=True, text=True, timeout=5)
        if "NOT A GIT REPO" in r.stdout:
            print(f" {Y('·')} Not a git repository")
        elif r.stdout.strip():
            print(f" {C('git status')}")
            print(r.stdout.strip())
        else:
            print(f" {G('✓')} Clean working tree")
    except: pass

def cmd_undo(msgs):
    if len(msgs) < 2:
        print(f" {Y('-')} Nothing to undo"); return
    removed_user = msgs.pop()
    removed_asst = msgs.pop()
    print(f" {G('✓')} Undid last exchange")

def cmd_export(msgs):
    path = os.path.join(DATA_DIR, f"session_{datetime.now().strftime('%Y%m%d_%H%M%S')}.md")
    try:
        with open(path, "w") as f:
            f.write("# ProCode Session\n\n")
            for m in msgs:
                if m["role"] == "system": continue
                label = "You" if m["role"] == "user" else "ProCode"
                f.write(f"**{label}:**\n{m['content']}\n\n")
        print(f" {G('✓')} Exported {W(f'({len(msgs)} msgs)')} → {os.path.basename(path)}")
    except Exception as e:
        print(f" {R('✗')} {e}")

