def cmd_edit(args):
    parts = args.split(None, 1)
    if not parts:
        print(f" {R('✗')} Usage: /edit <file> <new content> or /edit <file> (opens $EDITOR)")
        return
    fpath = os.path.expanduser(parts[0])
    if not os.path.exists(fpath):
        # Try creating new file
        content = parts[1] if len(parts) > 1 else ""
        with open(fpath, "w") as f: f.write(content)
        print(f" {G('✓')} Created {fpath}")
        return
    old = open(fpath).read()
    if len(parts) > 1:
        new = parts[1]
    else:
        print(f" {Y('?')} No content provided. Use /write to create new files.")
        return
    with open(fpath, "w") as f: f.write(new)
    print(f" {G('✓')} Updated {fpath}")

def cmd_write(args):
    parts = args.split(None, 1)
    if not parts:
        print(f" {R('✗')} Usage: /write <file> <content>")
        return
    fpath = os.path.expanduser(parts[0])
    content = parts[1] if len(parts) > 1 else ""
    os.makedirs(os.path.dirname(fpath) or ".", exist_ok=True)
    with open(fpath, "w") as f: f.write(content)
    print(f" {G('✓')} Wrote {fpath}")

def cmd_undo(msgs):
    if len(msgs) < 2:
        print(f" {Y('-')} Nothing to undo")
        return
    msgs.pop()
    msgs.pop()
    print(f" {G('✓')} Undone")

def cmd_export(msgs):
    path = os.path.join(DATA_DIR, f"session_{datetime.now().strftime('%Y%m%d_%H%M%S')}.md")
    with open(path, "w") as f:
        f.write("# ProCode Session Export\n\n")
        for m in msgs:
            f.write(f"**{m['role']}**:\n{m['content']}\n\n")
    print(f" {G('✓')} Exported to {path}")

