    print(f"  {W('Budget:')}    ${_usage:.4f} used  {D(f'({_usage/1.0*100:.1f}%)')}")
    if _last_response_time:
        print(f"  {W('Last:')}     {_last_model_name}  {D(f'{_last_response_time:.1f}s')}")

