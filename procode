def main():
    cwd = os.getcwd()
    sessions = load_sessions()
    active_name = sessions.get("active")
    session_list = sessions.get("sessions", {})

    if isinstance(session_list, list):
        session_list = {}
        sessions["sessions"] = session_list

    if active_name and active_name in session_list:
        msgs = session_list[active_name]["msgs"]
    else:
        msgs = [{"role": "system", "content": f"{SYSTEM}\nCWD: {cwd}"}]

    global _session_tokens
    if active_name and active_name in session_list:
        st = session_list[active_name].get("tokens", {})
        _session_tokens = {"prompt": st.get("prompt",0), "completion": st.get("completion",0), "total": st.get("total",0)}

    last_model = None
    try: readline.read_history_file(HIST_FILE)
    except: pass

    if len(sys.argv) > 1:
        p = " ".join(sys.argv[1:])
        if p.startswith("/sh "): print(run_sh(p[4:]))
        elif p.startswith("/read "): cmd_read(p[6:])
        elif p.startswith("/grep "):
            for f in search_grep(p[6:]): print(f)
        elif p.startswith("/glob "):
            for f in gb.glob(p[6:], recursive=True)[:20]:
                if os.path.isfile(f): print(f)
        else:
            msgs.append({"role": "user", "content": p})
            spinner_stop = threading.Event()
            spinner = threading.Thread(target=show_spinner, args=(spinner_stop,))
            spinner.start()
            content, model = send(msgs)
            spinner_stop.set()
            spinner.join()
            if content:
                print(content)
                saved = save_blocks(content)
                if saved:
                    for s in saved: print(f" {G('\u2713')} {os.path.basename(s)}")
                msgs.append({"role": "assistant", "content": content})
        return

    os.system('clear')
    print(header())
    print()

    while True:
        try: inp = input(f" {C('\u25b8')} ").strip()
        except: print(); break
        if not inp: continue

        if inp in ("exit", "quit", "/q"): print(); break
        if inp == "/clear":
            os.system('clear')
            print(header())
            print()
            continue
        if inp == "/help": cmd_help(); continue
        if inp == "/stats": cmd_stats(); continue
        if inp == "/models": cmd_models(); continue
        if inp == "/undo": cmd_undo(msgs); continue
        if inp == "/export": cmd_export(msgs); continue
        if inp == "/status": cmd_status(); continue
        if inp.startswith("/read "): cmd_read(inp[6:]); continue
        if inp.startswith("/write "): cmd_write(inp[7:]); continue
        if inp.startswith("/edit "): cmd_edit(inp[6:]); continue
        if inp.startswith("/diff "): cmd_diff(inp[6:]); continue
        if inp.startswith("/sh "): print(run_sh(inp[4:])); continue
        if inp.startswith("/grep "):
            for f in search_grep(inp[6:]): print(f" {D('\u00b7')} {f}")
            continue
        if inp.startswith("/glob "):
            for f in gb.glob(inp[6:], recursive=True)[:20]:
                if os.path.isfile(f): print(f" {D('\u00b7')} {f}")
            continue
        if inp.startswith("/save "):
            name = inp[6:].strip()
            if not name: name = f"session_{len(session_list)+1}"
            data = {"msgs": msgs.copy(), "time": time.time(), "tokens": _session_tokens.copy()}
            session_list[name] = data
            sessions["sessions"] = session_list
            sessions["active"] = name
            save_sessions(sessions)
            stok = _session_tokens["total"]
            print(f" {G('\u2713')} Saved '{name}'  {W(f'{len(msgs)} msgs, {stok} tok')}")
            continue
        if inp.startswith("/load "):
            name = inp[6:].strip()
            if name in session_list:
                msgs = session_list[name]["msgs"]
                sessions["active"] = name
                st = session_list[name].get("tokens", {})
                _session_tokens = {"prompt": st.get("prompt",0), "completion": st.get("completion",0), "total": st.get("total",0)}
                save_sessions(sessions)
                print(f" {G('\u2713')} Loaded '{name}'  {W(f'{len(msgs)} msgs')}")
            else: print(f" {R('\u2717')} Session '{name}' not found")
            continue
        if inp == "/sessions":
            if not session_list: print(f" {Y('-')} No saved sessions")
            else:
                for name, s in session_list.items():
                    age = ""
                    if "time" in s:
                        dm = int((time.time()-s["time"])/60)
                        age = "just now" if dm < 1 else f"{dm}m ago" if dm < 60 else f"{dm//60}h ago"
                    tok = s.get("tokens",{}).get("total",0)
                    scnt = len(s["msgs"])
                    print(f"  {G('\u25c9')} {name:20s} {D(f'{scnt} msgs')} {W(f'{tok}tok')}  {D(age)}")
            continue

        at_match = re.search(r'@(\S+)', inp)
        if at_match:
            files = fuzzy_files(at_match.group(1), limit=5)
            if files:
                fc = file_content(files[0])
                if fc:
                    inp = inp.replace(at_match.group(0), "") + f"\n```\n{fc}\n```"
                    print(f" {D('@')} {files[0]}")

        if inp.startswith("!"):
            out = run_sh(inp[1:])
            inp = f"$ {inp[1:]}\n{out}"

        inp_proc = re.sub(r'/read\s+(\S+)', lambda m: (
            f"\n```\n{open(os.path.expanduser(m.group(1))).read()}\n```\n"
            if os.path.exists(os.path.expanduser(m.group(1))) else m.group(0)
        ), inp)
        inp_proc = re.sub(r'/sh\s+(.*)', lambda m: f"\n$ {m.group(1)}\n{run_sh(m.group(1))}\n", inp_proc)

        msgs.append({"role": "user", "content": inp_proc})

        spinner_stop = threading.Event()
        spinner = threading.Thread(target=show_spinner, args=(spinner_stop,))
        spinner.start()
        content, model = send(msgs)
        spinner_stop.set()
        spinner.join()

        if not content:
            print(f" {R('\u2717')} No model available")
            msgs.pop()
            continue

        if model != last_model:
            icon = model_icon(model)
            print(f" {model_color(model)(f'{icon} [{model}]')}  {D(f'{_last_response_time:.1f}s')}")
            last_model = model

        print(content)
        msgs.append({"role": "assistant", "content": content})

        saved = save_blocks(content)
        if saved:
            names = [os.path.basename(s) for s in saved]
            print(f" {D('\u2500')} {G(', '.join(names))}")

        session_list["_latest"] = {"msgs": msgs.copy(), "time": time.time(), "tokens": _session_tokens.copy()}
        sessions["sessions"] = session_list
        save_sessions(sessions)

    try:
        readline.write_history_file(HIST_FILE)
        if len(msgs) > 1:
            session_list["_latest"] = {"msgs": msgs.copy(), "time": time.time(), "tokens": _session_tokens.copy()}
            sessions["sessions"] = session_list
            save_sessions(sessions)
    except: pass

if __name__ == "__main__":
    main()