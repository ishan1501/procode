#!/usr/bin/env python3
import sys, os, json, subprocess, re, readline, urllib.request, time, textwrap, shutil, glob as gb, threading
from datetime import datetime
from openai import OpenAI

DATA_DIR = os.path.expanduser("~/.procode")
CONFIG_PATH = os.path.join(DATA_DIR, "config.json")
SESSION_FILE = os.path.join(DATA_DIR, "session.json")
HIST_FILE = os.path.join(DATA_DIR, "history")
os.makedirs(DATA_DIR, exist_ok=True)

def _load_config():
    c = {}
    try:
        with open(CONFIG_PATH) as f: c = json.load(f)
    except: pass
    for k in ("PROCODE_OR_KEY","PROCODE_NV_KEY","PROCODE_OR_BASE","PROCODE_NV_BASE"):
        v = os.environ.get(k)
        if v: c[k.lower().replace("procode_","")] = v
    return c

_cfg = _load_config()
OR_KEY = _cfg.get("or_key", "")
NV_KEY = _cfg.get("nv_key", "")
OR_BASE = _cfg.get("or_base", "https://openrouter.ai/api/v1")
NV_BASE = _cfg.get("nv_base", "https://integrate.api.nvidia.com/v1")

# Free model chain - no payment needed
PROVIDERS_RAW = [
    ("DS V4 Pro",    NV_KEY, NV_BASE, "deepseek-ai/deepseek-v4-pro", 16384, {}, 30),
    ("DS V4 Pro 2",  NV_KEY, NV_BASE, "deepseek-ai/deepseek-v4-pro", 16384, {}, 30),
    ("Llama4 Mav",   NV_KEY, NV_BASE, "meta/llama-4-maverick-17b-128e-instruct", 8192, {}, 25),
    ("Nemotron S49", NV_KEY, NV_BASE, "nvidia/llama-3.3-nemotron-super-49b-v1", 8192, {}, 25),
    ("Nem Reason",   OR_KEY, OR_BASE, "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free", 8192, {}, 15),
]

CLIENTS = {}
for n, k, b, _, _, _, _ in PROVIDERS_RAW:
    try: CLIENTS[n] = OpenAI(api_key=k, base_url=b) if k else None
    except: pass

G = lambda t: f"\033[38;5;46m{t}\033[0m"
Y = lambda t: f"\033[38;5;227m{t}\033[0m"
C = lambda t: f"\033[38;5;87m{t}\033[0m"
B = lambda t: f"\033[1m{t}\033[0m"
D = lambda t: f"\033[2m{t}\033[0m"
R = lambda t: f"\033[38;5;196m{t}\033[0m"
M = lambda t: f"\033[38;5;201m{t}\033[0m"
W = lambda t: f"\033[38;5;250m{t}\033[0m"
BL = lambda t: f"\033[38;5;33m{t}\033[0m"

SYSTEM = "You are ProCode. Write working code with no comments. Output files inside ```code blocks with filename on first line as comment. Use /sh to run commands."

_usage = 0.216
_last_budget_check = 0
_session_tokens = {"prompt": 0, "completion": 0, "total": 0}
_spinner_active = False
_last_response_time = 0
_last_model_name = ""

def refresh_budget():
    global _usage, _last_budget_check
    if time.time() - _last_budget_check < 60: return
    try:
        req = urllib.request.Request(f"{OR_BASE}/auth/key", headers={"Authorization":f"Bearer {OR_KEY}"})
        d = json.loads(urllib.request.urlopen(req, timeout=5).read())
        _usage = d.get("data",{}).get("usage", _usage)
        _last_budget_check = time.time()
    except: pass

def budget_line():
    refresh_budget()
    limit = 1.0
    p = max(0, min(1, 1 - _usage / limit))
    w = 14
    f = int(p * w)
    bar = "━" * f + "─" * (w - f)
    c = G if p > 0.6 else Y if p > 0.3 else R
    return f"{c(bar)} {c(f'{p*100:.0f}%')}"

def token_bar():
    t = _session_tokens["total"]
    if t == 0: return ""
    kb = t / 1000
    return f"{W(f'{kb:.1f}K')}"

def header():
    cols = shutil.get_terminal_size().columns
    bl = budget_line()
    tk = token_bar()
    parts = [f" {C('\u25c6')} {B('ProCode')}", f"{G('FREE')}", f"{D('|')}  {bl}"]
    if tk: parts.append(f"{D('|')} {tk}tok")
    return " ".join(parts)[:cols]

def call_api(name, msgs, max_tok=4096):
    c = CLIENTS.get(name)
    if not c: return None, 0, 0
    p = next(x for x in PROVIDERS_RAW if x[0] == name)
    kw = {"model": p[3], "messages": msgs, "max_tokens": min(max_tok, p[4]), "stream": False,
          "extra_headers": {"HTTP-Referer":"https://procode.ai","X-Title":"ProCode"}}
    if p[5]: kw["extra_body"] = p[5]
    try:
        r = c.chat.completions.create(**kw, timeout=p[6])
        pt = r.usage.prompt_tokens if r.usage else 0
        ct = r.usage.completion_tokens if r.usage else 0
        content = r.choices[0].message.content if r.choices else ""
        return content, pt, ct
    except: return None, 0, 0

def send(msgs):
    global _last_response_time, _last_model_name
    for p in PROVIDERS_RAW:
        start = time.time()
        content, pt, ct = call_api(p[0], msgs)
        if content:
            _last_response_time = time.time() - start
            _last_model_name = p[0]
            _session_tokens["prompt"] += pt
            _session_tokens["completion"] += ct
            _session_tokens["total"] += pt + ct
            return content, p[0]
        elif "free" in p[3] or "reasoning" in p[3].lower(): pass
    return None, None

def show_spinner(stop_event):
    chars = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    i = 0
    while not stop_event.is_set():
        sys.stdout.write(f"\r {C(chars[i%len(chars)])} {W('thinking')} ")
        sys.stdout.flush()
        i += 1
        time.sleep(0.08)
    sys.stdout.write("\r" + " " * 20 + "\r")
    sys.stdout.flush()

def run_sh(cmd):
    try: r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=60); return (r.stdout + r.stderr)[:10000]
    except: return ""

def fuzzy_files(q, limit=10):
    ql = q.lower()
    res = []
    for root, dirs, files in os.walk("."):
        dn = os.path.basename(root)
        if dn.startswith(".") or dn in ("__pycache__","node_modules"): continue
        for f in files:
            fp = os.path.join(root, f)
            if ql in fp.lower() or ql in f.lower():
                try: res.append((fp, os.path.getsize(fp)))
                except: pass
    res.sort(key=lambda x: x[1])
    return [r[0][2:] if r[0].startswith("./") else r[0] for r in res[:limit]]

def file_content(path):
    try: return open(os.path.expanduser(path)).read()
    except: return None

def search_grep(pattern, path="."):
    try:
        r = subprocess.run(f"rg -l '{pattern}' {path} 2>/dev/null || grep -rl '{pattern}' {path} 2>/dev/null", shell=True, capture_output=True, text=True, timeout=15)
        return [f for f in r.stdout.strip().split("\n") if f][:30]
    except: return []

def save_blocks(text):
    saved = []
    for lang, code in re.findall(r'```(\w*)\n(.*?)```', text, re.DOTALL):
        code = code.strip()
        if not code: continue
        fn = None
        for l in code.split("\n")[:3]:
            m = re.match(r'^(?:#|//|--)\s*(.+)', l)
            if m: fn = m.group(1).strip(); break
        if not fn:
            m = re.search(r'filename[=:]\s*"?([^"\s]+)"?', text)
            fn = m.group(1) if m else f"out_{datetime.now().strftime('%H%M%S')}.{lang or 'txt'}"
        p = os.path.expanduser(fn)
        os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
        try:
            with open(p,"w") as f: f.write(code)
            saved.append(p)
        except: pass
    if not saved:
        lines = text.strip().split("\n")
        if lines:
            m = re.match(r'^(?:#|//|--)\s*(\S+\.\w+)', lines[0])
            if m:
                p = os.path.expanduser(m.group(1))
                try:
                    with open(p,"w") as f: f.write("\n".join(lines[1:]))
                    saved.append(p)
                except: pass
    return saved

def load_sessions():
    try:
        with open(SESSION_FILE) as f: return json.load(f)
    except: return {"sessions": {}, "active": None}

def save_sessions(data):
    try:
        with open(SESSION_FILE, "w") as f: json.dump(data, f)
    except: pass

def model_color(name):
    if "Pro" in name: return C
    if "Mav" in name: return G
    if "S49" in name: return BL
    if "Reason" in name: return W
    return W

def model_icon(name):
    if "Pro" in name: return "\u25c6"
    if "Mav" in name: return "\u25b6"
    if "S49" in name: return "\u25a0"
    if "Reason" in name: return "\u25cb"
    return "\u25cf"

def cmd_read(args):
    c = file_content(args)
    if c is not None:
        _, ext = os.path.splitext(args)
        lang = ext.lstrip(".") if ext else ""
        total = len(c)
        lines = c.count("\n") + 1
        print(f"\n{D('\u2500' * 4)} {W(args)} {D(f'{lines}L {total}B')} {D('\u2500' * max(2, shutil.get_terminal_size().columns - len(args) - 20))}")
        if lang in ("py","js","ts","go","rs","java","c","cpp","h","css","html","xml","json","yaml","yml","toml","sh","bash","md","rb","php","swift","kt","sql"):
            print(f"```{lang}\n{c}\n```")
        else:
            print(c)
    else:
        print(f" {R('\u2717')} File not found: {args}")

def cmd_write(args):
    parts = args.split(None, 1)
    if not parts: print(f" {R('\u2717')} /write <file> <content>"); return
    fpath = os.path.expanduser(parts[0])
    content = parts[1] if len(parts) > 1 else ""
    os.makedirs(os.path.dirname(fpath) or ".", exist_ok=True)
    try:
        with open(fpath, "w") as f: f.write(content)
        print(f" {G('\u2713')} {W(os.path.basename(fpath))}  {D(f'{len(content)}B')}")
    except Exception as e: print(f" {R('\u2717')} {e}")

def cmd_edit(args):
    parts = args.split(None, 1)
    if not parts: print(f" {R('\u2717')} /edit <file> <content>"); return
    fpath = os.path.expanduser(parts[0])
    if not os.path.exists(fpath): cmd_write(args); return
    old = open(fpath).read()
    new = parts[1] if len(parts) > 1 else ""
    try:
        with open(fpath, "w") as f: f.write(new)
        lo, ln = old.count("\n")+1, new.count("\n")+1
        print(f" {G('\u2713')} {W(os.path.basename(fpath))}  {D(f'{lo}\u2192{ln}L')}")
    except Exception as e: print(f" {R('\u2717')} {e}")

def cmd_diff(args):
    if not args: print(f" {R('\u2717')} /diff <file>"); return
    fpath = os.path.expanduser(args)
    if not os.path.exists(fpath): print(f" {R('\u2717')} Not found"); return
    r = subprocess.run(f"git diff --stat HEAD -- '{fpath}' 2>/dev/null || echo 'NOGIT'", shell=True, capture_output=True, text=True, timeout=5)
    if r.returncode == 0 and r.stdout.strip() and "NOGIT" not in r.stdout:
        subprocess.run(f"git diff HEAD -- '{fpath}' | head -80", shell=True)
    else:
        print(f" {Y('\u00b7')} No diff available")

def cmd_status():
    r = subprocess.run("git status --short 2>/dev/null || echo 'NOGIT'", shell=True, capture_output=True, text=True, timeout=5)
    out = r.stdout.strip()
    if "NOGIT" in out: print(f" {Y('\u00b7')} Not a git repo")
    elif out: print(f" {C('\u2387')} {out}")
    else: print(f" {G('\u2713')} Clean tree")

def cmd_undo(msgs):
    if len(msgs) < 2: print(f" {Y('-')} Nothing to undo"); return
    msgs.pop(); msgs.pop()
    print(f" {G('\u2713')} Undone")

def cmd_export(msgs):
    path = os.path.join(DATA_DIR, f"session_{datetime.now().strftime('%Y%m%d_%H%M%S')}.md")
    try:
        with open(path, "w") as f:
            f.write("# ProCode Session\n\n")
            for m in msgs:
                if m["role"] == "system": continue
                label = "You" if m["role"] == "user" else "ProCode"
                f.write(f"**{label}:**\n{m['content']}\n\n")
        print(f" {G('\u2713')} Exported  {W(f'{len(msgs)} msgs')}  {D(f'\u2192 {os.path.basename(path)}')}")
    except Exception as e: print(f" {R('\u2717')} {e}")

